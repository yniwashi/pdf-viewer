{
  "schema_version": "0.1",
  "helper_type": "ap_pediatric_dosing",
  "version": "0.1",
  "status": "active",
  "source": {
    "based_on": "Current Android ApMedicationCalculations.kt logic",
    "created_for": "Remote-configurable AP pediatric medication dosing",
    "important": "This helper is active remote dosing data. Validate every update before publishing, and keep version/schema_version aligned with app config."
  },
  "input_profiles": {
    "ap_months": {
      "label": "AP Months",
      "age_unit": "months",
      "min_age": 1,
      "max_age": 12,
      "estimated_weight_formula": {
        "type": "linear",
        "expression": "age_months * 0.5 + 4"
      },
      "range_message": "This age exceeds 12 months. Please choose the years section in pediatrics for appropriate guidance."
    },
    "ap_years": {
      "label": "AP Years",
      "age_unit": "years",
      "min_age": 1,
      "max_age": 14,
      "estimated_weight_formula": {
        "type": "piecewise",
        "rules": [
          {
            "when": {
              "age_years_min": 1,
              "age_years_max": 5
            },
            "expression": "age_years * 2 + 8"
          },
          {
            "when": {
              "age_years_min": 6,
              "age_years_max": 14
            },
            "expression": "age_years * 3 + 7"
          }
        ]
      },
      "range_message": "This age exceeds the pediatric range. Please refer to the CPG by pressing the view icon for appropriate medication guidance."
    }
  },
  "app_support_contract": {
    "supported_rule_types": [
      "static",
      "static_range",
      "not_indicated",
      "weight_based_single",
      "weight_based_range",
      "conditional",
      "age_or_weight_tier",
      "display_only"
    ],
    "rendering_rules": [
      "Medications with enabled=false are hidden.",
      "Sections with enabled=false are hidden.",
      "Unknown fields should be ignored safely.",
      "Unknown dose_rule types must not be calculated.",
      "This AP helper is age-input driven to match the current Android AP screens.",
      "Weight is estimated from age using the selected AP profile.",
      "WAAFELSS is included because it is shown in the current AP Months/Years medication grid."
    ]
  },
