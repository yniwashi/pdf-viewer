  "input_profiles": {
    "ap_months": {
      "estimated_weight_formula": {
        "type": "linear",
        "expression": "age_months * 0.5 + 4"
      },
      "label": "AP Months",
      "max_age": 12,
      "min_age": 1,
      "age_unit": "months",
      "range_message": "This age exceeds 12 months. Please choose the years section in pediatrics for appropriate guidance."
    },
    "ap_years": {
      "estimated_weight_formula": {
        "type": "piecewise",
        "rules": [
          {
            "when": {
              "age_years_min": 1,
              "age_years_max": 5
            },
            "expression": "age_years * 2 + 8"
          },
          {
            "when": {
              "age_years_min": 6,
              "age_years_max": 14
            },
            "expression": "age_years * 3 + 7"
          }
        ]
      },
      "label": "AP Years",
      "max_age": 14,
      "min_age": 1,
      "age_unit": "years",
      "range_message": "This age exceeds the pediatric range. Please refer to the CPG by pressing the view icon for appropriate medication guidance."
    }
  },
  "schema_version_history": [
    {
      "status": "active",
      "date": "2026-05-10",
      "summary": "Initial active AP pediatric dosing helper with AP Months/Years profiles, medication UI metadata, concentration modes, conditional dose rules, and AP-focused medication sections.",
      "schema_version": "0.1"
    }
  ],
  "implementation_notes": [
    "AP helper is intentionally smaller than CCP because AP has fewer medications and fewer indications in the current app.",
    "Current AP Android screens are age-input based. The helper keeps AP Months and AP Years estimated-weight formulas in input_profiles.",
    "Future AP wiring should reuse the CCP helper repository/engine pattern where possible, but helper_type must remain ap_pediatric_dosing.",
    "Keep parsers tolerant of unknown metadata fields. Do not let editor-guide metadata affect dose calculations."
  ],
  "medication_lifecycle_contract": {
    "deleted_from_helper": "Medication should disappear completely from the app after the helper is refreshed. Cached copies should be replaced by the latest valid helper.",
    "section_enabled_false": "Section remains in the helper but must be hidden from the medication result sheet.",
    "enabled_false": "Medication remains in the helper for review or future reactivation but must be hidden from app medication lists, search, and calculators.",
