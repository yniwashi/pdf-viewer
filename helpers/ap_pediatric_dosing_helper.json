  "review_notes": [
    "This helper is production-ready remote dosing data after clinical review; Android wiring can use it as the AP helper source.",
    "The current Android AP screen accepts age only, not direct weight. This helper mirrors that age-driven behavior.",
    "Adrenaline, Amiodarone, Defibrillation, Dextrose, Fluids, Ipratropium, Paracetamol Syrup, Salbutamol, and WAAFELSS are included because they are the current AP button set.",
    "Button colors match the soft palette currently used for AP/CCP medication buttons.",
    "WAAFELSS contains display-only formulas/placeholders that may need implementation support before wiring.",
    "Paracetamol Syrup uses AP-specific age tiers and marks 6-14 years as not indicated for the HMCAS infant syrup bottle.",
    "Dextrose 10% and Fluids are administration volumes, not concentration-based draw-up calculations."
  ],
  "section_schema_contract": {
    "required_section_fields": [
      "id",
      "enabled",
      "applies_to",
      "indication",
      "dose_rule"
    ],
    "standard_optional_section_fields": [
